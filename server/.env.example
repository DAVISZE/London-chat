# Copy to .env and fill in values from LiveKit Cloud.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
PORT=3000

# Firebase project ID for Firebase Admin token verification.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FAMILY_SESSION_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET

# Comma-separated frontend origins allowed to call this backend.
ALLOWED_ORIGINS=http://localhost:5173
